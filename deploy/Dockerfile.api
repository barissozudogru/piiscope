# Stage 1: Builder
FROM python:3.12-slim AS builder

WORKDIR /opt/build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY pyproject.toml README.md LICENSE ./
COPY piiscope ./piiscope
COPY api ./api

RUN pip install --no-cache-dir ".[server]"

# Stage 2: Final
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libcairo2 libgdk-pixbuf-2.0-0 shared-mime-info fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

RUN useradd -m -u 10001 piiscope

WORKDIR /code

COPY --from=builder /opt/venv /opt/venv
COPY --chown=piiscope:piiscope pyproject.toml README.md LICENSE ./
COPY --chown=piiscope:piiscope piiscope ./piiscope
COPY --chown=piiscope:piiscope api ./api

RUN mkdir -p api/uploads api/exports api/reports logs && \
    chown -R piiscope:piiscope api/uploads api/exports api/reports logs

USER piiscope

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health').status==200 else 1)"

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
