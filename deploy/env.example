# Example environment configuration for piiscope
# Copy this file to `.env` in the project root and adjust values as needed.

# Database connection string
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER:-piiscope}:${POSTGRES_PASSWORD:-piiscope}@db:5432/${POSTGRES_DB:-piiscope}

# Redis broker URL for Celery
REDIS_URL=redis://redis:6379/0

# Secret key used to sign JWT tokens (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=9b12ec592307358282322a962c1f53c22ef20f899895bac2ecee6e31bbffafdc

# Algorithm for JWT
JWT_ALGORITHM=HS256

# Expiration for access tokens in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AES encryption key for raw files, 32 bytes base64 encoded (generate with: python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())")
ENCRYPTION_KEY=sGA3IMIwsQ1JyM9tXreRKyHxBjEho3IQqm2QyAst2Ss=

# Retention period for stored findings/raw data (in hours)
DATA_RETENTION_HOURS=24

# Allow outbound network calls
ALLOW_EGRESS=false

# TLS certificate file for HTTPS
TLS_CERT_FILE=

# TLS key file for HTTPS
TLS_KEY_FILE=

# Maximum allowed file size for uploads in MB
MAX_FILE_SIZE_MB=2048

# Maximum chunk size for processing
MAX_CHUNK_SIZE=10000

# Rate limit per minute for the API
RATE_LIMIT_PER_MINUTE=100

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Logging format (e.g., json or text)
LOG_FORMAT=json

# Enable security headers on API responses
ENABLE_SECURITY_HEADERS=true

# CORS origins allowed to access the API
CORS_ORIGINS=http://localhost:3000,https://localhost:3000

# Default administrator username for initial setup
DEFAULT_ADMIN_USER=admin@piiscope.local

# Default administrator password for initial setup
DEFAULT_ADMIN_PASSWORD=adminpass

# Postgres username (used by docker-compose)
POSTGRES_USER=piiscope

# Postgres password (used by docker-compose)
POSTGRES_PASSWORD=piiscope

# Postgres database name (used by docker-compose)
POSTGRES_DB=piiscope
# Directory for rotating security, audit and performance log files (must be writable; falls back to console logging if not)
LOG_DIR=logs

# Host ports published by docker compose (change if something else already listens)
API_PORT=8000
UI_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
# URL the browser uses to reach the API; must match API_PORT and be listed in CORS_ORIGINS
PIISCOPE_API_URL=http://localhost:8000
